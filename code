## 3.1. Real-Time Data Update and Storage
@app.callback(
    [Output('live-gauge-plot', 'figure'),
     Output('historical-data-store', 'data')],
    [Input('interval-component', 'n_intervals')],
    [State('historical-data-store', 'data')]
)
def update_data_and_store(n, current_data_json):
    # Fetch new data
    new_data = get_live_data(limit=1).reset_index().rename(columns={'index': 'timestamp'})
    
    # 1. Update Historical Data Store (for the 'data over time' requirement)
    # Convert existing JSON data back to DataFrame, append new data, and trim
    if current_data_json:
        history_df = pd.DataFrame(current_data_json)
    else:
        history_df = pd.DataFrame(columns=['timestamp'] + SENSOR_LIST)
        
    # Append and keep only the last MAX_HISTORY_HOURS
    history_df = pd.concat([history_df, new_data], ignore_index=True)
    
    # Remove duplicates and sort (robustness)
    history_df = history_df.drop_duplicates(subset=['timestamp']).sort_values('timestamp')
    
    # Trim old data
    trim_time = dt.datetime.now() - dt.timedelta(hours=MAX_HISTORY_HOURS)
    history_df = history_df[history_df['timestamp'] >= trim_time.isoformat()] 
    
    new_data_json = history_df.to_dict('records') # Store back as list of dicts/json
    
    # 2. Update Live Gauge Plot (for immediate status)
    latest_temp = new_data['T_Cold_Head_K'].iloc[-1]
    gauge_fig = go.Figure(go.Indicator(
        mode = "gauge+number",
        value = latest_temp,
        title = {'text': "Cold Head Temp (K)"},
        gauge = {'axis': {'range': [None, 5.0]},
                 'steps': [
                     {'range': [4.5, 5.0], 'color': "red"},
                     {'range': [1.0, 4.5], 'color': "green"}],
                 'bar': {'color': "darkblue"}}
    ))
    gauge_fig.update_layout(margin=dict(l=20, r=20, t=30, b=30))
    
    return gauge_fig, new_data_json

## 3.2. Time Series Plotting (Using Stored Data)
@app.callback(
    Output('time-series-plot', 'figure'),
    [Input('historical-data-store', 'data'),
     Input('sensor-dropdown', 'value')]
)
def update_time_series_plot(data_json, selected_sensors):
    if not data_json or not selected_sensors:
        return go.Figure()
        
    history_df = pd.DataFrame(data_json)
    history_df['timestamp'] = pd.to_datetime(history_df['timestamp']) # Ensure datetime type
    
    fig = go.Figure()
    for sensor in selected_sensors:
        # Plot data over time
        fig.add_trace(go.Scatter(
            x=history_df['timestamp'],
            y=history_df[sensor],
            mode='lines',
            name=sensor
        ))
        
    fig.update_layout(
        title='Sensor Data Over Time',
        xaxis_title='Time',
        yaxis_title='Sensor Value',
        hovermode="x unified",
        uirevision='constant' # Keeps zoom/pan settings
    )
    # TODO: Add vertical lines for key events (e.g., control changes, anomalies)
    return fig

